# SalesPilot — environment example
#
# Copy this to `.env` and fill in real values. The real `.env` is gitignored.
# In production, secrets come from /opt/salespilot/secrets/*.env (read-only
# mounted by the host compose files), not from this file.

# --- Database ---
# In dev with default compose, host=postgres, port=5432.
POSTGRES_USER=salespilot
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=salespilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=changeme_dev_only
REDIS_HOST=redis
REDIS_PORT=6379

# --- Application secrets ---
# Use `openssl rand -hex 32` to generate.
APP_SECRET_KEY=please_replace_with_a_random_64_char_hex_string
JWT_SECRET=please_replace_with_a_random_64_char_hex_string

# Magic-link tokens expire after this many minutes.
MAGIC_LINK_TTL_MINUTES=15
# JWT access tokens expire after this many minutes.
JWT_TTL_MINUTES=60
# JWT refresh tokens expire after this many days.
JWT_REFRESH_TTL_DAYS=30

# --- Mail (for magic-link) ---
# Leave SMTP_HOST empty to log magic links to stdout instead of sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sales.hostingportal.org
SMTP_STARTTLS=true

# --- App config ---
APP_BASE_URL=https://sales.hostingportal.org
ENV=development
LOG_LEVEL=INFO
# Origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,https://sales.hostingportal.org
